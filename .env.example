# Copy to .env.local for development. Production values are GitHub Actions secrets (see .github/workflows/deploy.yml).

# Supabase: Project Settings > API. The URL is the origin only (https://<ref>.supabase.co, no path).
# The key is the publishable (sb_publishable_...) or legacy anon key. NEVER the secret/service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Show "Continue with Apple" on the web once the Apple provider is configured in Supabase Auth.
VITE_AUTH_APPLE=false
